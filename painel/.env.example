# Copie para .env.local e preencha com a configuração do app WEB do seu projeto
# Firebase (Console > Configurações do projeto > Seus apps > SDK setup and configuration),
# ou rode na raiz:  npx firebase-tools apps:sdkconfig web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
