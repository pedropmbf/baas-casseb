# Modo de desenvolvimento com os emuladores do Firebase (não precisa de projeto real).
# Na raiz:   firebase emulators:start --project demo-circuito
# No painel: npm run dev:emulador
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-circuito.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-circuito
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
